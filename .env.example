# Copy to .env and fill in. chmod 600 .env
CHHOTO_PASSWORD=change-me
# Generate: tr -dc A-Za-z0-9 </dev/urandom | head -c 128
CHHOTO_API_KEY=change-me
CHHOTO_SITE_URL=https://example.com

# Database MUST live on the mounted volume, or it is lost on container recreate.
CHHOTO_DB_URL=/data/urls.sqlite
CHHOTO_SQLITE_USE_WAL_MODE=true

# Uncomment if any YOURLS keywords contain uppercase letters
CHHOTO_ALLOW_CAPITAL_LETTERS=true
# Uncomment if you have (or expect) more than a few thousand links
#CHHOTO_SLUG_STYLE=UID
#CHHOTO_SLUG_LENGTH=16
